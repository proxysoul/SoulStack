{
  "name": "soulstack-site",
  "private": true,
  "type": "module",
  "scripts": {
    "og": "bun scripts/build-og.ts",
    "docs": "bun scripts/build-docs.ts && cd .. && node immune/app/server.mjs immune/app/immune.config.json --export site/public/immunity",
    "dev": "bun run docs && vite --port 5190",
    "build": "bun run docs && tsc --noEmit && vite build && bun scripts/finalize.ts",
    "preview": "vite preview --port 5190",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "deploy:check": "bun run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "wrangler": "^4.138.0",
    "marked": "^18.0.14"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.32",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
