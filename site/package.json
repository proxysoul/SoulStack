{
  "name": "soulstack-site",
  "private": true,
  "type": "module",
  "scripts": {
    "og": "bun scripts/build-og.ts",
    "docs": "bun scripts/build-docs.ts && cd .. && node immune/app/server.mjs immune/app/immune.config.json --export site/public/immunity",
    "dev": "bun run docs && vite --port 5190",
    "build": "bun run docs && vite build",
    "preview": "vite preview --port 5190",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "deploy:check": "bun run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "wrangler": "^4.138.0"
  },
  "dependencies": {
    "marked": "^18.0.14"
  }
}
